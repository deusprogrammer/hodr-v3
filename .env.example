OPENAI_API_KEY=
# Point at an OpenAI-compatible server hosting your models (e.g. vLLM, Ollama, LM Studio)
OPENAI_BASE_URL=

# Optional: false disables thinking; true enables it. Unset uses server defaults.
# THINKING=false

# Per-agent model overrides (default: qwen3-8B)
EXPLORER_MODEL=qwen3:8b
PLANNER_MODEL=qwen3:8b
SUBJECT_MODEL=qwen3:8b
TRANSLATOR_MODEL=qwen3:8b
PROCTOR_MODEL=qwen3:8b

# Any of these values may also be set in a test config's "env" object
# (e.g. tests/profile.json); config values override this file.
